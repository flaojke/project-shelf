{
  "name": "project-shelf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Windows desktop launcher with four configurable project adapters",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  }
}
